# Copy this file to .env and fill in your local values.
# Vite loads these in dev; the auth server reads them via loadEnv in vite.config.ts.

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-with-node-crypto
BETTER_AUTH_URL=http://localhost:5173

# PostgreSQL (same instance as the Django backend)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgre
DB_PASSWORD=12345
DB_NAME=scheduler
# Copy this file to .env and fill in your local values.
# Vite loads these in dev; the auth server reads them via loadEnv in vite.config.ts.

# Django API base URL
VITE_API_URL=http://localhost:8000

# Show the "Quick Demo Access" buttons on the login page. Leave unset/false
# for production so demo credentials are never exposed.
VITE_DEMO_MODE=true

# PostgreSQL (same instance as the Django backend)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgre
DB_PASSWORD=12345
DB_NAME=scheduler
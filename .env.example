# ---------------------------------------------------------------------------
# Docker Compose deployment configuration
# Copy this file to .env and change every "change-me" value before deploying:
#   cp .env.example .env
# Docker Compose reads .env automatically for variable interpolation.
# ---------------------------------------------------------------------------

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=scheduler
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=change-me

# --- Django / API ---------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
FRONTEND_URL=http://localhost

# Host port the Nginx frontend is published on.
HTTP_PORT=80

# --- Frontend build -------------------------------------------------------
# Leave empty for same-origin requests through the Nginx reverse proxy.
# Set to an absolute URL if the API lives on a different origin.
VITE_API_URL=

# --- Gunicorn -------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=300

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/1

# --- TLS / proxy (enable after terminating TLS) ---------------------------
DJANGO_USE_X_FORWARDED_PROTO=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- Email (optional; console backend when EMAIL_HOST is empty) -----------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Scheduler <noreply@school.edu>

# --- Misc -----------------------------------------------------------------
# Creates the demo_admin / demo_admin123 superuser when set to 1.
# Keep 0 on any public deployment.
SEED_DEMO_ADMIN=0
DJANGO_LOG_LEVEL=INFO
